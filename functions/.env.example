# Copy to .env for the emulator, or set via `firebase functions:secrets:set`
# for deployed environments. Never commit real values.

# Private app token dedicated to Aviva Pay Desk. Do NOT reuse Ro_Bot's
# general-purpose token (section 6).
HUBSPOT_PRIVATE_APP_TOKEN=

# Shared secret sent verbatim (no "Bearer " prefix) by the HubSpot
# workflow's "Send a webhook" action in the Authorization header, so
# syncDealWebhook can verify the request actually came from the workflow.
HUBSPOT_WEBHOOK_SECRET=

# Public base URL of the deployed frontend (section 6: pay.avivacredito.com).
# Stores log in here with their código and NIP, so this is the same link
# for everyone — there is no per-store secret URL.
PAYDESK_BASE_URL=https://pay.avivacredito.com
