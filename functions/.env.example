# Copy to .env for the emulator, or set via `firebase functions:secrets:set`
# for deployed environments. Never commit real values.

# Private app token dedicated to Aviva Pay Desk. Do NOT reuse Ro_Bot's
# general-purpose token (section 6).
HUBSPOT_PRIVATE_APP_TOKEN=

# Shared secret sent verbatim (no "Bearer " prefix) by the HubSpot
# workflow's "Send a webhook" action in the Authorization header, so
# syncDealWebhook can verify the request actually came from the workflow.
HUBSPOT_WEBHOOK_SECRET=

# Public base URL of the deployed frontend (section 6: pay.avivacredito.com).
# Stores log in here with their código and NIP, so this is the same link
# for everyone — there is no per-store secret URL.
# Sin esto se usa https://<projectId>.web.app, que siempre resuelve.
# Ponlo solo cuando el dominio propio ya exista y apunte a Hosting.
# PAYDESK_BASE_URL=https://pay.avivacredito.com

# Llave de la API de Claude (console.anthropic.com) con la que se verifican
# las cotizaciones y comprobantes que suben las tiendas. En producción va
# como secreto: firebase functions:secrets:set ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=

# Token del bot de Slack (xoxb-...) para las notificaciones de documentos en
# revisión. Scopes: chat:write, chat:write.public, im:write, users:read.email.
# En producción: firebase functions:secrets:set SLACK_BOT_TOKEN
SLACK_BOT_TOKEN=

# App Check: exigir que las llamadas de tiendas y la página del vale vengan
# del sitio de Paydesk. Ponlo en "true" SOLO después de desplegar el sitio
# con VITE_APP_CHECK_SITE_KEY; antes dejaría fuera a todas las tiendas.
# Ver "Seguridad" en docs/ARCHITECTURE.md.
APP_CHECK_ENFORCE=false
