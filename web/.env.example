# Firebase Web SDK config for the Aviva Pay Desk project (from the Firebase
# console, Project settings > General > Your apps). Public by design — these
# are not secrets, access control is enforced by Cloud Functions and
# Firestore rules, not by hiding this config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Base URL for the uploadCotizacion / uploadComprobante HTTP functions.
# Local: http://127.0.0.1:5001/<project-id>/us-central1
VITE_FUNCTIONS_BASE_URL=
