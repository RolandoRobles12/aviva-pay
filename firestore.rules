rules_version = '2';

// Aviva Pay Desk has two kinds of caller.
//
// A concesionario (Construrama store) is a real Firebase Auth
// email/password account, invited by an admin adding their email to one
// or more stores (see concesionario/userSync.ts). That grants a
// `concesionarioIds` custom claim — every store id that account can see —
// which is what lets the page open a realtime Firestore listener on
// exactly those stores' deals and nothing else: the rule below requires
// every read to match a concesionarioId in that list, so a client cannot
// widen the query to see another store's clients.
//
// An Aviva admin signs in with a Firebase Auth email/password account
// carrying an `admin: true` custom claim (granted out of band, never by the
// app). Admins read through Cloud Functions rather than directly, so they
// get no blanket read grant here.
//
// All writes happen from Cloud Functions using the Admin SDK, which
// bypasses these rules — there is no client write path anywhere.
service cloud.firestore {
  match /databases/{database}/documents {

    match /paydesk_deals/{dealId} {
      allow get, list: if request.auth != null
                        && request.auth.token.concesionarioIds is list
                        && resource.data.concesionarioId in request.auth.token.concesionarioIds;
      allow write: if false;
    }

    // Store documents list invited emails, so no client reads them
    // directly — the store gets the name it needs from
    // getConcesionarioDeals, which projects only safe fields.
    match /paydesk_concesionarios/{concesionarioId} {
      allow read, write: if false;
    }

    // Reverse index (uid -> stores) that custom claims are computed from.
    // Admin-managed only, via concesionario/userSync.ts.
    match /paydesk_concesionario_users/{uid} {
      allow read, write: if false;
    }

    // Field dictionary: read and written only through the admin Cloud
    // Functions, which check the `admin` claim.
    match /paydesk_config/{document} {
      allow read, write: if false;
    }

    // Admin roster and its audit log: read and written only through the
    // admin Cloud Functions (adminListAdmins, adminCreateAdmin,
    // adminRevokeAdmin). The `admin` custom claim, not either of these
    // collections, is what actually grants access — see adminGuard.ts.
    match /paydesk_admins/{uid} {
      allow read, write: if false;
    }
    match /paydesk_admin_audit/{entryId} {
      allow read, write: if false;
    }
  }
}
