rules_version = '2';

// The canonical copy of every cotización/comprobante file — what
// "Ver archivo" in Paydesk links to (see functions/src/storage/dealFiles.ts).
// A second copy also goes to HubSpot Files (functions/src/hubspot/files.ts)
// for the Aviva team's own CRM view, but that copy is access-gated to
// HubSpot logins, so Paydesk's own UI never links there. Clients never
// write to Storage directly — uploads go through the uploadCotizacion /
// uploadComprobante (and admin/*) callable functions so the deal_id and
// file can be validated server-side first. No client read/write path
// exists. A file is only reachable through a 15-minute signed URL that
// the getArchivoUrl function issues to the store that owns the deal or
// to an admin (see functions/src/storage/dealFiles.ts).
service firebase.storage {
  match /b/{bucket}/o {
    match /paydesk_deals/{dealId}/{allPaths=**} {
      allow read, write: if false;
    }
  }
}
